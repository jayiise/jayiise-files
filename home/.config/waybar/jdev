#!/usr/bin/env bash

# joyproj • by jayimist@github.com • joyproj dev-file templates
# Change at your liking!

SESSION="C-waybar"
PROJECT="/home/jay/.config/waybar"
OLD_WD="$PWD"

cd "$PROJECT"

if tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux attach-session -t "$SESSION"
    exit 0
fi

tmux new-session -d -s "$SESSION"

tmux send-keys -t "$SESSION:0.0" "nvim config.jsonc style.css" Enter
tmux split-window -h -t "$SESSION"
tmux attach-session -t "$SESSION"

cd "$OLD_WD"
