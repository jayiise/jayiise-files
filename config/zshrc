# Init
eval "$(~/.local/bin/oh-my-posh init zsh -c ~/.config/oh-my-posh/config.toml)"
echo "hi jay"

# Aliases
alias zfig="nvim ~/.zshrc"
alias nfig="nvim ~/.config/niri/config.kdl"
alias kfig="nvim ~/.config/kitty/kitty.conf"
alias afig='nvim ~/.config/alacritty/alacritty.toml ~/.config/alacritty/theme.toml'
alias pfig="nvim ~/.config/oh-my-posh/config.toml"
alias bfig='jp d cfg-waybar'

alias ls="eza --group-directories-first --color=always --icons=always"
alias ll="eza --group-directories-first --color=always --icons=always -lh"
alias sl="eza --group-directories-first --color=always --icons=always -A"
alias ss="eza --group-directories-first --color=always --icons=always -lAh"
alias tree="eza --tree --group-directories-first --color=always --icons=always"
alias eert="eza --tree --group-directories-first --color=always --icons=always -A"

alias jdev='./jdev "$@"'
alias jbuild='./jbuild "$@"'
alias jrun='./jrun "$@"'

alias joyproj='~/.python/bin/python3 ~/.joythings/joyproj/joyproj.py "$@"'
alias jp='~/.python/bin/python3 ~/.joythings/joyproj/joyproj.py "$@"'

alias py='~/.python/bin/python3 "$@"'
